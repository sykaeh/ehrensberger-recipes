---
layout: layouts/base.njk
---

<div class="recipe-container">
  <article class="recipe">
    <header>
      <div class="title-container">
        <h1 class="title">{{ title }}</h1>
      </div>
      <p>{{ quote }}</p>
      {% for tag in tags %}
        <span class="category">
          {{ tag }}
        </span>
      {% endfor %}
      {% if source %}
        <p>Source: {{ source }}</p>
      {% endif %}
    </header>
      <section class="infos">
        <div class="table-container">
          <table>
            <thead>
              <tr>
                <th class="rounded-l-sm border-r">Servings</th>
                <th >Prep Time</th>
                <th class="rounded-r-sm border-l">Cooking Time</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td class="border-r">{{ yield | default('n/a') }}</td>
                <td>{{ prep | default('n/a') }}</td>
                <td class="border-l">{{ cook | default('n/a') }}</td>
              </tr>
            </tbody>
          </table>
        </div>
        <div class="ingredients">
          <h2>Ingredients</h2>
          {% for list in ingredients | trim | makeList %}
          <ul>
            {% for ingredient in list %}
              <li>{{ ingredient }}</li>
            {% endfor %}
          </ul>
          {% endfor %}
          </ul>
        </div>
      </section>
      <section class="instructions">
        <h2>Instructions</h2>

        {{ content | safe }}
      </section>
  </article>

  {% if image %}
    {% responsiveImage './src' + image, title, "recipe-picture" %}
  {% endif %}
</div>
